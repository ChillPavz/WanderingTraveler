{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "license": "${license}",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.chillpavz.wanderingtraveler.WanderingTravelerFabric"
        ],
        "modmenu": [
            "com.chillpavz.wanderingtraveler.WanderingTravelerModMenu"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${fabric_minecraft_version_range}",
        "java": ">=${java_version}",
        "cloth-config2": "*"
    },
    "recommends": {
        "modmenu": "*"
    }
}
